--// PROGRESS FUNCTION

local function setProgress(value, message, decimal)
    value = math.clamp(value, 0, 100)

    percentage.Text = decimal
        and string.format("%.3f%%", value)
        or math.floor(value) .. "%"

    status.Text = string.upper(message)

    tween(fill, 0.22, {
        Size = UDim2.new(value / 100, 0, 1, 0)
    })

    tween(indicator, 0.2, {
        BackgroundColor3 = RED_LIGHT
    })
end

