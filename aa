--// LOADING

task.spawn(function()

    setProgress(0, "Initializing", false)
    task.wait(0.5)

    -- 0 TO 70 | 30 SECONDS

    for i = 1, 70 do

        local message =
            i < 30 and "Loading components" or
            i < 55 and "Configuring modules" or
            "Preparing environment"

        setProgress(i, message, false)

        task.wait(30 / 70)
    end

    -- 70 TO 100 | 10 MINUTES

    setProgress(70, "Applying protection layers", true)

    for i = 1, 400 do

        local current = 70 + (i / 400) * 30

        local message =
            current < 83 and "Applying protection layers" or
            current < 93 and "Verifying system integrity" or
            "Finalizing initialization"

        setProgress(current, message, true)

        task.wait(600 / 400)
    end

    --// COMPLETE

    setProgress(100, "Successfully loaded", true)

    title.Text = "Welcome to HUYU"
    subtitle.Text = "Client initialization completed."

    task.wait(2)

    --// EXIT

    tween(panel, 0.65, {
        BackgroundTransparency = 1,
        Position = UDim2.fromScale(0.5, 0.47)
    })

    for _, obj in ipairs(panel:GetDescendants()) do

        if obj:IsA("TextLabel") then
            tween(obj, 0.4, {
                TextTransparency = 1
            })

        elseif obj:IsA("Frame") then
            tween(obj, 0.4, {
                BackgroundTransparency = 1
            })

        elseif obj:IsA("UIStroke") then
            tween(obj, 0.4, {
                Transparency = 1
            })
        end
    end

    tween(background, 0.7, {
        BackgroundTransparency = 1
    })

    task.wait(0.8)

    if gui.Parent then
        gui:Destroy()
    end

end)
